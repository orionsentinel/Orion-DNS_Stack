# Orion Sentinel — monitoring stack configuration.
# cp .env.example .env && sudo nano .env

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password
GRAFANA_ROOT_URL=http://192.168.8.245:3000

# --- Signal alerting (optional but recommended) ---
# Register the sender number once against signal-cli-rest-api (see
# signal-cli-config/README.md), then set these. Leave blank to disable paging.
SIGNAL_CLI_REST_API_URL=http://signal-cli-rest-api:8080
SIGNAL_CLI_MODE=native
SIGNAL_NUMBER=
# Comma-separated recipient numbers in E.164 form, e.g. +301234567890,+301234567891
SIGNAL_RECIPIENTS=
