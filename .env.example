# =============================================================================
# Orion Sentinel DNS — SINGLE-NODE environment (template)
# Copy to .env and fill in the secrets:  cp .env.example .env && sudo nano .env
#
# This is the SINGLE-node profile (one Pi, no HA): Pi-hole + Unbound + autoheal.
# For two-Pi HA, use env/primary.env.example and env/secondary.env.example instead.
# Canonical network: see docs/networking.md.
# =============================================================================

# Node identity
HOSTNAME=orion-dns
NODE_IP=192.168.8.244
NETWORK_INTERFACE=eth0
TZ=Europe/Athens
DOMAIN_NAME=lan

# Pi-hole web admin password — CHANGE THIS (use a strong, unique value)
WEBPASSWORD=CHANGE_ME_strong_password
# Pi-hole API password (v6+). Leave blank to reuse WEBPASSWORD.
FTLCONF_webserver_api_password=

# DNS — local recursive resolution via the bundled Unbound on port 5335
FTLCONF_dns_upstreams=127.0.0.1#5335
FTLCONF_dns_dnssec=true
FTLCONF_local_ipv4=${NODE_IP}
DNSMASQ_LISTENING=all

# Reverse DNS (local name resolution via the router)
REV_SERVER=true
REV_SERVER_TARGET=192.168.8.1
REV_SERVER_DOMAIN=lan
REV_SERVER_CIDR=192.168.8.0/24

# Unbound (optional DoT forwarding; blank = full local recursion)
UNBOUND_FORWARD_TLS=
UNBOUND_FORWARD_ZONES=

# Self-healing watchdog (autoheal) — tunables
AUTOHEAL_INTERVAL=10
AUTOHEAL_START_PERIOD=120

# Redis (optional; only if the image build enables it)
REDIS_ENABLE=false
