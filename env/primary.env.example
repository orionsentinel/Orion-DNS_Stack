# =============================================================================
# Orion Sentinel DNS HA - PRIMARY Node Environment (template)
# =============================================================================
# Copy to env/primary.env on Node A and fill in the secrets.
#   cp env/primary.env.example env/primary.env
#   sudo nano env/primary.env
#
# Primary Node (pi-dns-1)  -  IP 192.168.8.244  -  Role MASTER  -  Priority 200
# Canonical network (see docs/networking.md):
#   Node A (MASTER) 192.168.8.244 | Node B (BACKUP) 192.168.8.245
#   Floating VIP    192.168.8.243 | Router/gateway  192.168.8.1
# =============================================================================

# Node Identity
HOSTNAME=pi-dns-1
NODE_IP=192.168.8.244

# Dedicated USB-C / USB 2.5-10G NIC (optional)
# Run: sudo ./scripts/configure-nic.sh   (pins NODE_IP onto this interface,
# survives reboot, disables EEE/WoL flapping). List NICs: --list.
# Set NETWORK_INTERFACE (below) to this NIC so DNS + the VRRP VIP ride the fast link.
LINK_CIDR=24                 # prefix length for NODE_IP
LINK_GATEWAY=192.168.8.1
LINK_DNS=127.0.0.1
LINK_MAC=                    # optional: bind to the NIC's MAC (robust vs eth1/enx renames)
LINK_MTU=1500                # set 9000 for jumbo frames on a 2.5-10G link
LINK_NM_NAME=orion-fastlan

# Keepalived HA Configuration
NODE_ROLE=MASTER
KEEPALIVED_PRIORITY=200
ROUTER_ID=orion-dns-ha

# Virtual IP Configuration
VIP_ADDRESS=192.168.8.243
VIP_NETMASK=32
NETWORK_INTERFACE=eth0

# VRRP Configuration
VIRTUAL_ROUTER_ID=51
# CRITICAL: VRRP_PASSWORD must be EXACTLY 8 characters (VRRP PASS auth limitation)
# Generate one: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 8; echo
VRRP_PASSWORD=CHANGE_8c

# Unicast VRRP (recommended for point-to-point HA on a LAN with no multicast)
USE_UNICAST_VRRP=true
UNICAST_SRC_IP=192.168.8.244
PEER_IP=192.168.8.245

# Health Check Configuration
CHECK_DNS_TARGET=127.0.0.1
CHECK_DNS_FQDN=pi.hole
CHECK_INTERVAL=5
CHECK_TIMEOUT=3
CHECK_WEIGHT=-20
CHECK_FALL=2
CHECK_RISE=2

# Pi-hole Configuration
TZ=Europe/Athens
DOMAIN_NAME=lan

# Web admin password - CHANGE THIS (use a strong, unique value)
WEBPASSWORD=CHANGE_ME_strong_password

# Pi-hole API password (Pi-hole v6+). Leave blank to reuse WEBPASSWORD.
FTLCONF_webserver_api_password=

# DNS - local recursive resolution via the bundled Unbound on port 5335
FTLCONF_dns_upstreams=127.0.0.1#5335
FTLCONF_dns_dnssec=true
FTLCONF_local_ipv4=${NODE_IP}

# DNS listening mode
DNSMASQ_LISTENING=all

# Reverse DNS Configuration
REV_SERVER=true
REV_SERVER_TARGET=192.168.8.1
REV_SERVER_DOMAIN=lan
REV_SERVER_CIDR=192.168.8.0/24

# Unbound (optional DoT forwarding; blank = full local recursion)
UNBOUND_FORWARD_TLS=
UNBOUND_FORWARD_ZONES=

# Redis (optional)
REDIS_ENABLE=false
REDIS_SERVER=redis:6379
REDIS_PASSWORD=

# Prometheus Pushgateway (optional)
PROM_PUSHGATEWAY_URL=
PROM_JOB_NAME=orion_dns_ha
PROM_INSTANCE_LABEL=node-primary

# Loki for log shipping (optional) - point at your monitoring host
LOKI_URL=http://192.168.8.245:3100/loki/api/v1/push
